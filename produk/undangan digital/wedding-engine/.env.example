# Cloudflare R2 Storage Configuration (S3-compatible)
# Dapatkan kredensial ini di Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=nikahhub-assets
# URL Domain Publik R2 (misal: https://pub-xxxx.r2.dev atau domain kustom Anda)
R2_PUBLIC_DOMAIN=https://pub-xxxx.r2.dev
